# Example Multi-Location Dockerfile (Alternative Approach)
# Builds all code locations in a single image - useful for simpler deployments

FROM python:3.12-slim

WORKDIR /opt/dagster/app

# Install uv for faster dependency management
RUN pip install uv

# Copy the entire mono-repo
COPY . /opt/dagster/app

# Install all dependencies using the root pyproject.toml
# This automatically installs all code locations + shared package
RUN uv pip install --system -e .

# The DAGSTER_MODULE_NAME environment variable will be set at runtime
# to specify which code location to run (e.g., "fintech_alpha.definitions")

CMD ["sh", "-c", "dagster code-server start -m ${DAGSTER_MODULE_NAME}"]
